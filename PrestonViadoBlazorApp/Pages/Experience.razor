@page "/experience"

<PageTitle>Experience · Preston Viado</PageTitle>

<section class="work-intro">
    <h1>Where I've <strong>built and tested software</strong>, and what I shipped along the way.</h1>
</section>

<section class="work-grid">
    @for (int i = 0; i < jobs.Count; i++)
    {
        var j = jobs[i];
        <ExperienceCard Title="@j.Title" Company="@j.Company" Dates="@j.Dates"
                        Summary="@j.Summary" Image="@j.Image" Current="@j.Current"
                        Tint="@i" Delay="@(i * 100)" />
    }
</section>

@code {
    private record Job(string Title, string Company, string Dates,
                       string? Summary = null, string? Image = null, bool Current = false);

    // Replace these placeholders with your real positions, newest first
    private readonly List<Job> jobs = new()
    {
        new("Freelance Software Developer", "LarizzaRE.com", "August 2024 – Present",
            Summary: "",
            Current: true,
            Image: "Images/RealtorLogo.png"),

        new("AI Software Engineer Intern", "Radenta Technologies Inc.", "June 2025 - December 2025",
            Summary: "",
            Image: "Images/RadentaLogo2.png")
    };
}
<header class="site-header">
    <NavLink class="brand" href="" Match="NavLinkMatch.All">Preston Viado</NavLink>

    <button type="button" class="nav-toggle" title="Navigation menu" @onclick="ToggleNavMenu">
        &#9776;
    </button>

    <nav class="@NavMenuCssClass" @onclick="CloseNavMenu">
        <NavLink href="" Match="NavLinkMatch.All">About Me</NavLink>
        <NavLink href="CodeLab">Portfolio</NavLink>
        <NavLink href="Notebook">Preston's Notebook</NavLink>
    </nav>
</header>

@code {
    private bool navOpen = false;

    private string NavMenuCssClass => navOpen ? "top-nav open" : "top-nav";

    private void ToggleNavMenu() => navOpen = !navOpen;

    private void CloseNavMenu() => navOpen = false;
}